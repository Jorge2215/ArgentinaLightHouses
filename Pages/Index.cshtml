@page
@model IndexModel
@{
    ViewData["Title"] = "Map";
}
@section Styles {
    <link rel="stylesheet" href="~/lib/leaflet.markercluster/MarkerCluster.css" />
    <link rel="stylesheet" href="~/lib/leaflet.markercluster/MarkerCluster.Default.css" />
}
<div class="mb-3">
    <h1 class="alh-page-title">Map of Argentina Lighthouses</h1>
    <p class="alh-page-subtitle">@Model.Lighthouses.Count lighthouses positioned on the map with live weather from Open-Meteo (Developed by Gandalf and Jorgito)</p>
</div>
<div class="alh-grid-controls mb-2 d-flex flex-wrap gap-3 align-items-center">
    <label for="filter-province" class="alh-control-label">Filter by Province:</label>
    <select id="filter-province" class="alh-select form-select form-select-sm" style="width:auto">
        <option value="">All Provinces</option>
    </select>
    <label for="filter-name" class="alh-control-label">Search by name:</label>
    <div class="alh-search-control">
        <input id="filter-name"
               type="search"
               class="alh-search-input form-control form-control-sm"
               placeholder="Find a lighthouse by name"
               aria-label="Search map lighthouses by name" />
        <button id="clear-map-search"
                type="button"
                class="alh-search-clear"
                aria-label="Clear map lighthouse search"
                hidden>
            ×
        </button>
    </div>
    <span id="filter-count" class="alh-pale-text" style="font-size:0.88rem"></span>
</div>
<div id="lighthouse-map"></div>
@section Scripts {
<script src="~/lib/leaflet.markercluster/leaflet.markercluster.js"></script>
<script>
    const defaultMapCenter = [-38.5, -63.5];
    const defaultMapZoom = 4;
    const lighthouses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Lighthouses.Select(lh => new {
            lh.Name,
            lh.Location,
            lh.Description,
            Lat = lh.Latitude,
            Lon = lh.Longitude,
            lh.ImageUrl,
            Weather = lh.Weather == null ? null : new {
                Icon = lh.Weather.WeatherIcon,
                Desc = lh.Weather.WeatherDescription,
                Temp = lh.Weather.TemperatureC,
                Wind = lh.Weather.WindSpeedKmh
            }
        }),
        new System.Text.Json.JsonSerializerOptions {
            PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
        }));

    const map = L.map("lighthouse-map").setView(defaultMapCenter, defaultMapZoom);
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 18,
        attribution: "&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors"
    }).addTo(map);

    const lighthouseSvg = [
        '<svg xmlns="http://www.w3.org/2000/svg" width="36" height="48" viewBox="0 0 36 48">',
        '  <polygon points="18,10 36,0 36,4 18,13" fill="#FFE066" opacity="0.7"/>',
        '  <polygon points="18,10 0,0 0,4 18,13"  fill="#FFE066" opacity="0.7"/>',
        '  <rect x="12" y="5" width="12" height="7" rx="2" fill="#1a3a5c" stroke="#4a90c4" stroke-width="1"/>',
        '  <rect x="13" y="6" width="10" height="5" rx="1" fill="#FFE066"/>',
        '  <polygon points="11,5 18,1 25,5" fill="#c0392b"/>',
        '  <rect x="13" y="12" width="10" height="22" fill="white" stroke="#4a90c4" stroke-width="0.8"/>',
        '  <rect x="13" y="15" width="10" height="4" fill="#c0392b"/>',
        '  <rect x="13" y="23" width="10" height="4" fill="#c0392b"/>',
        '  <rect x="13" y="31" width="10" height="3" fill="#c0392b"/>',
        '  <rect x="11" y="11" width="14" height="2" rx="1" fill="#1a3a5c" stroke="#4a90c4" stroke-width="0.8"/>',
        '  <rect x="10" y="34" width="16" height="4" rx="1" fill="#1a3a5c" stroke="#4a90c4" stroke-width="0.8"/>',
        '  <rect x="16" y="29" width="4" height="5" rx="1" fill="#1a3a5c"/>',
        '  <path d="M4,42 Q9,39 14,42 Q19,45 24,42 Q29,39 34,42" stroke="#4a90c4" stroke-width="1.5" fill="none"/>',
        '  <path d="M2,45 Q8,42 14,45 Q20,48 26,45 Q30,42 35,45" stroke="#7ec8e3" stroke-width="1.2" fill="none" opacity="0.7"/>',
        '</svg>'
    ].join("");

    const lighthouseIcon = L.divIcon({
        html: lighthouseSvg,
        className: "alh-map-icon",
        iconSize: [36, 48],
        iconAnchor: [18, 46],
        popupAnchor: [0, -46]
    });

    const clusterGroup = L.markerClusterGroup({
        showCoverageOnHover: false,
        maxClusterRadius: 50,
        spiderfyOnMaxZoom: true,
        polygonOptions: {
            color: "#7ec8e3",
            weight: 1,
            fillColor: "#1a3a5c",
            fillOpacity: 0.18
        },
        iconCreateFunction(cluster) {
            const childCount = cluster.getChildCount();
            const sizeClass = childCount < 10
                ? "marker-cluster-small"
                : childCount < 100
                    ? "marker-cluster-medium"
                    : "marker-cluster-large";

            return L.divIcon({
                html: `<div><span>${childCount}</span></div>`,
                className: `marker-cluster alh-marker-cluster ${sizeClass}`,
                iconSize: L.point(40, 40)
            });
        }
    });
    const searchResultsLayer = L.layerGroup().addTo(map);

    function getProvince(location) {
        const parts = location.split(',');
        return parts[parts.length - 1].trim();
    }

    const markerEntries = lighthouses.map(lh => {
        const weatherHtml = lh.weather
            ? "<div class=\"popup-weather\"><div><span class=\"popup-temp\">" + lh.weather.icon + " " + (lh.weather.temp ?? 0).toFixed(1) + "C</span><br><span class=\"popup-wind\">Wind: " + (lh.weather.wind ?? 0).toFixed(1) + " km/h | " + lh.weather.desc + "</span></div></div>"
            : "<p style=\"color:#cce4f5;font-size:0.85rem\">Weather data could not be loaded. Check API configuration.</p>";
        const imageHtml = lh.imageUrl
            ? `<img class="popup-lighthouse-img" src="${lh.imageUrl}" alt="${lh.name}" loading="lazy"><p class="popup-attribution">© <a href="https://commons.wikimedia.org/" target="_blank" rel="noopener">Wikimedia Commons</a></p>`
            : "";
        const popup = "<div>" + imageHtml + "<div class=\"popup-title\">" + lh.name + "</div><div class=\"popup-location\">" + lh.location + "</div><div style=\"color:#e0f0ff;font-size:0.83rem;margin-bottom:4px\">" + lh.description + "</div>" + weatherHtml + "</div>";
        return {
            lighthouse: lh,
            marker: L.marker([lh.lat, lh.lon], { icon: lighthouseIcon }).bindPopup(popup, { maxWidth: 300 })
        };
    });

    // Build province dropdown
    const provinces = [...new Set(lighthouses.map(lh => getProvince(lh.location)))].sort();
    const sel = document.getElementById('filter-province');
    const nameFilterInput = document.getElementById('filter-name');
    const clearMapSearchButton = document.getElementById('clear-map-search');
    provinces.forEach(p => {
        const opt = document.createElement('option');
        opt.value = p; opt.textContent = p;
        sel.appendChild(opt);
    });

    function clearMarkerHighlights() {
        markerEntries.forEach(({ marker }) => marker.getElement()?.classList.remove('alh-map-marker-match'));
    }

    function syncMarkerLayer(entries, searchTerm) {
        clearMarkerHighlights();
        clusterGroup.clearLayers();
        searchResultsLayer.clearLayers();
        map.removeLayer(clusterGroup);

        if (!searchTerm) {
            clusterGroup.addLayers(entries.map(({ marker }) => marker));
            clusterGroup.addTo(map);
            return;
        }

        entries.forEach(({ marker }) => searchResultsLayer.addLayer(marker));
        window.requestAnimationFrame(() => {
            entries.forEach(({ marker }) => marker.getElement()?.classList.add('alh-map-marker-match'));
        });
    }

    function updateMapViewport(entries, province, searchTerm) {
        if (!entries.length) {
            map.setView(defaultMapCenter, defaultMapZoom);
            return;
        }

        if (!province && !searchTerm) {
            map.setView(defaultMapCenter, defaultMapZoom);
            return;
        }

        const bounds = L.latLngBounds(entries.map(({ lighthouse }) => [lighthouse.lat, lighthouse.lon]));

        if (searchTerm && entries.length === 1) {
            map.setView(bounds.getCenter(), Math.max(map.getZoom(), 8));
            return;
        }

        map.fitBounds(bounds, {
            padding: [32, 32],
            maxZoom: searchTerm ? 9 : 6
        });
    }

    function updateFilter() {
        const province = sel.value;
        const searchTerm = nameFilterInput.value.trim().toLowerCase();
        const filteredEntries = markerEntries.filter(({ lighthouse }) => {
            const lhProvince = getProvince(lighthouse.location);
            const matchesProvince = !province || lhProvince === province;
            const matchesSearch = !searchTerm || lighthouse.name.toLowerCase().includes(searchTerm);
            return matchesProvince && matchesSearch;
        });
        const count = filteredEntries.length;

        syncMarkerLayer(filteredEntries, searchTerm);
        updateMapViewport(filteredEntries, province, searchTerm);

        clearMapSearchButton.hidden = !searchTerm;

        const activeFilters = [];
        if (province) {
            activeFilters.push(province);
        }
        if (searchTerm) {
            activeFilters.push(`matching "${nameFilterInput.value.trim()}"`);
        }

        document.getElementById('filter-count').textContent = activeFilters.length
            ? `${count} lighthouse${count !== 1 ? 's' : ''} ${activeFilters.join(' • ')}`
            : `${lighthouses.length} lighthouses`;
    }

    sel.addEventListener('change', updateFilter);
    nameFilterInput.addEventListener('input', updateFilter);
    clearMapSearchButton.addEventListener('click', () => {
        nameFilterInput.value = '';
        nameFilterInput.focus();
        updateFilter();
    });
    updateFilter();
</script>
}