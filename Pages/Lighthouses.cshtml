@page
@model LighthousesModel
@{
    ViewData["Title"] = "Lighthouses";
}
<h1 class="alh-page-title">Argentina Lighthouses</h1>
<p class="alh-page-subtitle">@Model.Lighthouses.Count lighthouses with live weather conditions.</p>
<div class="alh-grid-controls mb-4 d-flex flex-wrap gap-3 align-items-center">
    <label for="lighthouse-search" class="alh-control-label">Search by name:</label>
    <div class="alh-search-control">
        <input id="lighthouse-search"
               type="search"
               class="alh-search-input form-control"
               placeholder="Find a lighthouse by name"
               aria-label="Search lighthouses by name" />
        <button id="clear-lighthouse-search"
                type="button"
                class="alh-search-clear"
                aria-label="Clear lighthouse search"
                hidden>
            ×
        </button>
    </div>
    <span id="lighthouse-search-count" class="alh-pale-text" aria-live="polite">@Model.Lighthouses.Count lighthouses</span>
</div>
<div id="lighthouse-card-grid" class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
    @foreach (var lh in Model.Lighthouses)
    {
        <div class="col alh-lighthouse-card" data-lighthouse-name="@lh.Name">
            <div class="card alh-card p-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <a href="/Lighthouse/@Uri.EscapeDataString(lh.Name)" class="alh-footer-link">
                            <div class="card-title">@lh.Name</div>
                        </a>
                        <div class="card-subtitle mb-2">@lh.Location</div>
                        <p class="card-text" style="font-size:0.85rem;color:#cce4f5">@lh.Description</p>
                    </div>
                    @if (lh.Weather != null)
                    {
                        <span class="weather-icon ms-2">@lh.Weather.WeatherIcon</span>
                    }
                </div>
                @if (lh.Weather != null)
                {
                    <div class="border-top mt-2 pt-2" style="border-color:var(--alh-light-blue)!important">
                        <span class="temp">@lh.Weather.TemperatureC.ToString("F1") C</span>
                        <span class="weather-desc ms-2">@lh.Weather.WeatherDescription</span>
                        <div class="wind mt-1">Wind: @lh.Weather.WindSpeedKmh.ToString("F1") km/h</div>
                    </div>
                }
                else
                {
                    <div class="border-top mt-2 pt-2" style="color:#cce4f5;font-size:0.85rem">Weather data could not be loaded. Check API configuration.</div>
                }
            </div>
        </div>
    }
</div>
<div id="no-lighthouses-found" class="alh-alert-warning mt-4 d-none" role="status" aria-live="polite">
    No lighthouses found.
</div>

@section Scripts {
<script>
    const lighthouseSearchInput = document.getElementById('lighthouse-search');
    const lighthouseSearchClearButton = document.getElementById('clear-lighthouse-search');
    const lighthouseCards = Array.from(document.querySelectorAll('.alh-lighthouse-card'));
    const lighthouseSearchCount = document.getElementById('lighthouse-search-count');
    const noLighthousesFound = document.getElementById('no-lighthouses-found');
    const totalLighthouseCount = lighthouseCards.length;

    function updateLighthouseFilter() {
        const searchTerm = lighthouseSearchInput.value.trim().toLowerCase();
        let visibleCount = 0;

        lighthouseCards.forEach(card => {
            const lighthouseName = (card.dataset.lighthouseName || '').toLowerCase();
            const matchesSearch = !searchTerm || lighthouseName.includes(searchTerm);
            card.hidden = !matchesSearch;

            if (matchesSearch) {
                visibleCount++;
            }
        });

        lighthouseSearchClearButton.hidden = !searchTerm;
        noLighthousesFound.classList.toggle('d-none', visibleCount > 0);
        lighthouseSearchCount.textContent = `${visibleCount} of ${totalLighthouseCount} lighthouses`;
    }

    lighthouseSearchInput.addEventListener('input', updateLighthouseFilter);
    lighthouseSearchClearButton.addEventListener('click', () => {
        lighthouseSearchInput.value = '';
        lighthouseSearchInput.focus();
        updateLighthouseFilter();
    });

    updateLighthouseFilter();
</script>
}